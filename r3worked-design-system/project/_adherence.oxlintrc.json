{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/icons/**",
              "showcase/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|as|className|style|onClick|href|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, as, className, style, onClick, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|ghost|ghost-dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'ghost' | 'ghost-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DarkPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<DarkPanel> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:arrow-right|bell|check|x|menu|send|user|map-pin|briefcase|chevron-down|camera|phone|phone-missed|message-square|star|clipboard-check|clipboard-list|file-text|route|user-check|mouse-pointer-click|check-circle|arrow-up-right|plus)$/]",
        "message": "<Icon> name must be one of 'arrow-right' | 'bell' | 'check' | 'x' | 'menu' | 'send' | 'user' | 'map-pin' | 'briefcase' | 'chevron-down' | 'camera' | 'phone' | 'phone-missed' | 'message-square' | 'star' | 'clipboard-check' | 'clipboard-list' | 'file-text' | 'route' | 'user-check' | 'mouse-pointer-click' | 'check-circle' | 'arrow-up-right' | 'plus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PremiumCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|hoverLift|className|style|key|ref|className|style|children)$/]",
        "message": "<PremiumCard> doesn't accept that prop. Declared props: children, hoverLift, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|dark|align|maxTitle|maxDescription|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, description, dark, align, maxTitle, maxDescription."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<SegmentedToggle> doesn't accept that prop. Declared props: options, value, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|pulse|dark|className|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, label, pulse, dark, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:received|routed|logged|live|follow-up-ready|coming-soon|missed-call|pending|inactive)$/]",
        "message": "<StatusPill> status must be one of 'received' | 'routed' | 'logged' | 'live' | 'follow-up-ready' | 'coming-soon' | 'missed-call' | 'pending' | 'inactive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SurfaceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tight|className|style|key|ref|className|style|children)$/]",
        "message": "<SurfaceCard> doesn't accept that prop. Declared props: children, tight, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|className|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
